<aside class="sidebar" data-sidebar>
  <pre class="sidebar-sphere" data-sphere data-cols="26" data-rows="11" aria-hidden="true">       ·············
    ···················
  ······ OMENSITE ······
    ···················
       ·············</pre>
  <div class="sidebar-brand">OMENSITE</div>
  <div class="sidebar-prompt">root@omensite:~$</div>

  <nav aria-label="Terminal navigation">
    <% page.navigation.forEach((item, index) => { %>
      <a class="navitem<%= item.key === page.route.key || (item.key === "journal" && ["journal-new", "journal-public"].includes(page.route.key)) ? " active" : "" %>" href="<%= item.path %>" data-nav-link data-nav-key="<%= item.key %>"<% if (item.key === page.route.key) { %> aria-current="page"<% } %>><%= index === page.navigation.length - 1 ? "`-- " : "|-- " %><%= item.uri === "alerts/support-resistance" ? "alerts/s-r" : item.uri %></a>
    <% }) %>
  </nav>

  <div class="sidebar-foot">
    <div>UPTIME <span data-uptime>0m 0s</span></div>
    <div>ALERTS ARMED 0</div>
    <div>SYNC: <span class="standby">STANDBY</span></div>
    <button class="btn btn-danger sidebar-logout" type="button" data-logout>[ LOGOUT ]</button>
  </div>
</aside>
