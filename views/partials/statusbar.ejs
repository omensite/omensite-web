<div class="statusbar" data-statusbar>
  <button class="navtoggle" type="button" title="Toggle navigation" aria-label="Toggle navigation" aria-expanded="false" data-nav-toggle>[≡]</button>
  <div class="statusbar-live"><span class="dot idle"></span>LIVE FEED</div>
  <div class="ticker" aria-label="Market feed status">
    <div class="ticker-track">
      <% ["MARKET FEED :: STANDBY", "NO SYMBOLS SUBSCRIBED", "AWAITING DATA SOURCE", "FEED SOCKET :: CLOSED", "MARKET FEED :: STANDBY", "NO SYMBOLS SUBSCRIBED", "AWAITING DATA SOURCE", "FEED SOCKET :: CLOSED"].forEach((segment) => { %>
        <span><span><%= segment %></span></span>
      <% }) %>
    </div>
  </div>
  <div class="statusbar-session" title="<%= page.operator?.roles?.join(", ") ?? "" %>">SESSION 01 / AUTHORIZED</div>
  <time class="statusbar-clock" data-clock></time>
</div>
