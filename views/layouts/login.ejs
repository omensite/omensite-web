<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>OMENSITE Login</title>
    <meta name="description" content="Omensite — a retro-terminal trading operations hub: alerts, TradingView indicator access, market news, financial reports, and a shareable trade journal.">
    <meta name="color-scheme" content="dark">
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Crect width='16' height='16' fill='%230b0f0d'/%3E%3Ctext x='1.5' y='12' font-family='monospace' font-size='11' fill='%2364e6a0'%3E%3E_%3C/text%3E%3C/svg%3E">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/omensite.css">
  </head>
  <body>
    <div class="crt-scan" aria-hidden="true"></div>
    <div class="crt-vignette" aria-hidden="true"></div>

    <main id="app" aria-live="polite">
      <section class="login" data-login-root>
        <pre class="login-sphere" data-sphere data-cols="34" data-rows="12" aria-hidden="true">         ·················
      ·························
    ·········   OMENSITE   ·········
      ·························
         ·················</pre>
        <div class="login-card">
          <pre class="login-banner"> ___  __  __ _____ _  _  ____ ___ _____ _____
/ _ \|  \/  || ____|| \| |/ ___||_   _|_   _|| ____|
| | | | |\/| || _|  | .  |\___ \  | |   | |  |  _|
| |_| | |  | || |___ | |\ | ___) | | |   | |  | |___
\___/|_|  |_||_____||_| \_||____/  |_|   |_|  |_____|</pre>
          <div class="login-sub">OMENSITE TRADING TERMINAL v2.4 :: RESTRICTED ACCESS</div>
          <form class="login-form" action="/auth/login" method="post" novalidate data-login-form>
            <div class="login-prompt">&gt; identify yourself to continue</div>
            <label class="field">USER
              <input name="username" type="text" placeholder="operator_id" autocomplete="off" spellcheck="false" required data-login-user>
            </label>
            <label class="field">PASSKEY
              <input name="passkey" type="password" placeholder="••••••••" autocomplete="off" required data-login-passkey>
            </label>
            <div class="login-err" hidden data-login-error></div>
            <button class="btn btn-primary btn-login" type="submit" data-login-submit>[ LOGIN ]</button>
            <div class="login-fineprint">SESSION WILL BE ENCRYPTED. UNAUTHORIZED ACCESS IS LOGGED.</div>
          </form>
        </div>
      </section>
    </main>

    <noscript>
      <div class="noscript">
        <pre>
 ___  __  __ _____ _  _  ____ ___ _____ _____
/ _ \|  \/  || ____|| \| |/ ___||_   _|_   _|| ____|
| | | | |\/| || _|  | .  |\___ \  | |   | |  |  _|
| |_| | |  | || |___ | |\ | ___) | | |   | |  | |___
\___/|_|  |_||_____||_| \_||____/  |_|   |_|  |_____|</pre>
        <p>&gt; JAVASCRIPT REQUIRED :: this terminal cannot render without a script runtime.</p>
      </div>
    </noscript>

    <script type="module" src="/js/login-controller.js"></script>
  </body>
</html>
