# Local authentication mode. Production accepts only discord.
AUTH_MODE=demo
SESSION_SECRET=replace-with-a-long-random-secret-before-hosting

# Discord OAuth2 application and server configuration.
# Keep the client secret private and never commit a populated value.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:4173/auth/discord/callback
DISCORD_GUILD_ID=
DISCORD_ROLE_DEVELOPER_ID=
DISCORD_ROLE_ADMIN_ID=
DISCORD_ROLE_OS_ID=
DISCORD_ROLE_INDICATORS_ID=
DISCORD_ROLE_JOURNAL_ID=
DISCORD_ROLE_REFRESH_MINUTES=5

# Demo mode only. Developer and Admin receive every capability.
DEMO_ROLES=Developer,Indicators,Journal

# Local server address used by npm start.
HOST=127.0.0.1
PORT=4173

# The public Economicium calendar requires no account or API key.
