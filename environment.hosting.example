APP_SLUG=example
APP_ENVIRONMENT=beta
APP_DOMAIN=beta.example.com
APP_ADDITIONAL_DOMAINS=
APP_HOST_RULE=Host(`beta.example.com`)
APP_CPUS=1.0
APP_MEMORY=1g
APP_PIDS_LIMIT=128
APP_HEALTH_PATH=/health
APP_INTERNAL_PORT=3000
APP_AUTH_MIDDLEWARE=security-headers@file,compression@file
DATABASE_URL=stored-in-portainer-not-this-file
DATABASE_SSL=disable
SESSION_SECRET=stored-in-portainer-not-this-file
AUTH_MODE=proxy-for-beta-or-discord-for-production
DISCORD_CLIENT_ID=stored-in-portainer-not-this-file
DISCORD_CLIENT_SECRET=stored-in-portainer-not-this-file
DISCORD_REDIRECT_URI=https://example.com/auth/discord/callback
DISCORD_GUILD_ID=stored-in-portainer-not-this-file
DISCORD_ROLE_DEVELOPER_ID=stored-in-portainer-not-this-file
DISCORD_ROLE_ADMIN_ID=stored-in-portainer-not-this-file
DISCORD_ROLE_OS_ID=stored-in-portainer-not-this-file
DISCORD_ROLE_INDICATORS_ID=stored-in-portainer-not-this-file
DISCORD_ROLE_JOURNAL_ID=stored-in-portainer-not-this-file
DISCORD_ROLE_REFRESH_MINUTES=5
APP_MIGRATION_COMMAND=npm run migrate
